# LOCAL DEVELOPMENT VALUES ONLY. Copy to .env:  cp .env.example .env
# These passwords match db/init/00-roles.sql and are not secrets.
# Never put real (staging/production) credentials in this file.

# Superuser password for the local Postgres container (used by docker compose).
POSTGRES_PASSWORD=postgres

# Host port for the container. If you change it, change it in the URLs below
# (and in .env.test) too.
POSTGRES_PORT=5432

# The API connects as ledger_app (limited privileges).
DATABASE_URL=postgres://ledger_app:ledger_app_local@localhost:5432/ledger

# Migrations connect as ledger_owner (owns the tables).
OWNER_DATABASE_URL=postgres://ledger_owner:ledger_owner_local@localhost:5432/ledger

PORT=3000

# Payment provider (step 4). Locally this is the mock provider: `npm run provider`.
PROVIDER_URL=http://localhost:4100
# Shared secret the provider uses to sign webhooks. DUMMY LOCAL VALUE; real
# environments get a real secret from a secret store, never from git.
WEBHOOK_SECRET=local-dev-webhook-secret-change-me

# Used by the mock provider process only.
PROVIDER_PORT=4100
LEDGER_WEBHOOK_URL=http://localhost:3000/webhooks/provider
