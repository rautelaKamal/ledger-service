{
  "name": "ledger-service",
  "version": "0.1.0",
  "private": true,
  "description": "Double-entry ledger service (Postgres, raw SQL, Express)",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "demo:race": "tsx --env-file=.env scripts/demo-race.ts",
    "demo:retry": "tsx --env-file=.env scripts/demo-retry.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
