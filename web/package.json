{
  "name": "ledger-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev --port 3200",
    "build": "next build",
    "start": "next start --port 3200",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --experimental-strip-types --no-warnings --test --test-reporter=spec --test-timeout=10000 tests/*.test.ts",
    "test:e2e": "playwright test --project=flows",
    "screenshots": "playwright test --project=shots-desktop-light --project=shots-desktop-dark --project=shots-phone-light --project=shots-phone-dark",
    "lighthouse": "playwright test --project=lighthouse",
    "check:policies": "node scripts/check-policy-excerpts.mjs"
  },
  "dependencies": {
    "@redis/client": "6.3.1",
    "@tanstack/react-table": "9.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.69.0",
    "next": "16.4.5",
    "next-themes": "0.4.6",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "lighthouse": "13.6.0",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "1.4.0",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
