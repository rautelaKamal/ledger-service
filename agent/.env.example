# Copy to agent/.env (gitignored). Loaded by the agent at start-up if present;
# real environment variables take precedence.

# The database role for the assistant (same as the repo's .env).
AGENT_DATABASE_URL=postgres://ledger_agent:ledger_agent_local@localhost:5432/ledger
# Ingestion of policy documents writes as the owner.
OWNER_DATABASE_URL=postgres://ledger_owner:ledger_owner_local@localhost:5432/ledger

# Gemini API key (Google AI Studio). NEVER commit a real key.
GOOGLE_API_KEY=replace-me

# Models. Defaults are the ones Google recommends for new projects (Nov 2026).
AGENT_MODEL=gemini-3.5-flash-lite
AGENT_EMBEDDING_MODEL=gemini-embedding-2
AGENT_EMBEDDING_DIMENSIONS=768

# Questions per client per rolling 24 hours (counted from agent_runs).
AGENT_DAILY_LIMIT=20

# Optional: LangSmith tracing. Leave unset and nothing is sent anywhere.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=replace-me
# LANGSMITH_PROJECT=ledger-agent
