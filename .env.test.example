# LOCAL TEST VALUES ONLY. Copy to .env.test:  cp .env.test.example .env.test
# Same roles as .env, but pointing at the separate ledger_test database,
# which the test suite truncates before every run.

DATABASE_URL=postgres://ledger_app:ledger_app_local@localhost:5432/ledger_test
OWNER_DATABASE_URL=postgres://ledger_owner:ledger_owner_local@localhost:5432/ledger_test
